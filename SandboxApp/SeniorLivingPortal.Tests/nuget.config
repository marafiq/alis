<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="local-proxy" value="https://localhost:5555/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-proxy">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
