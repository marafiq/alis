@model IEnumerable<MedicationAdministrationViewModel>

@if (!Model.Any())
{
    <div class="text-center text-muted py-4">
        <p class="mb-0">No medications found matching your criteria.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 30px;">
                        <input type="checkbox" class="form-check-input" id="selectAll" />
                    </th>
                    <th>Time</th>
                    <th>Resident</th>
                    <th>Medication</th>
                    <th>Dosage</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var med in Model.OrderBy(m => m.ScheduledTime))
                {
                    var isPastDue = med.ScheduledTime < TimeOnly.FromDateTime(DateTime.Now);
                    <tr class="medication-item @(isPastDue ? "table-warning" : "")">
                        <td>
                            <input type="checkbox"
                                   class="form-check-input med-checkbox"
                                   value="@med.ScheduleId" />
                        </td>
                        <td>
                            <span class="@(isPastDue ? "text-danger fw-bold" : "")">
                                @med.ScheduledTime.ToString("h:mm tt")
                            </span>
                            @if (isPastDue)
                            {
                                <span class="badge bg-danger ms-1">Past Due</span>
                            }
                        </td>
                        <td>
                            @* ALIS Feature: Inline link loading with target *@
                            <a href="#"
                               class="med-resident text-decoration-none"
                               data-alis-get="/Medications/ByResident?residentId=@med.ResidentId"
                               data-alis-target="#resident-details"
                               data-alis-trigger="click"
                               data-alis-indicator="is-loading">
                                @med.ResidentName
                            </a>
                        </td>
                        <td>
                            <span class="med-name fw-semibold">@med.MedicationName</span>
                        </td>
                        <td>@med.Dosage</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                @* ALIS Feature: Quick action with POST and confirm *@
                                <button type="button"
                                        class="btn btn-success btn-sm"
                                        data-alis-post="/Medications/QuickGive"
                                        data-alis-collect="self"
                                        data-alis-target="#medications-list"
                                        data-alis-swap="innerHTML"
                                        data-alis-confirm-message="Mark @med.MedicationName as given?"
                                        data-alis-on-after="initMedicationControls"
                                        data-alis-indicator="is-loading">
                                    <input type="hidden" name="scheduleId" value="@med.ScheduleId" />
                                    Given
                                </button>

                                @* ALIS Feature: Load modal content *@
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm"
                                        data-alis-get="/Medications/Administer?scheduleId=@med.ScheduleId"
                                        data-alis-target="#administerModalBody"
                                        data-alis-on-after="showAdministerModal"
                                        data-alis-indicator="is-loading">
                                    Other
                                </button>

                                @* ALIS Feature: View history *@
                                <button type="button"
                                        class="btn btn-outline-info btn-sm"
                                        data-alis-get="/Medications/History?residentId=@med.ResidentId"
                                        data-alis-target="#resident-details"
                                        data-alis-swap="innerHTML"
                                        data-alis-indicator="is-loading">
                                    History
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<script>
    // Select all checkbox handling
    document.getElementById('selectAll')?.addEventListener('change', function () {
        const checkboxes = document.querySelectorAll('.med-checkbox');
        checkboxes.forEach(cb => cb.checked = this.checked);
        if (typeof updateBulkButton === 'function') {
            updateBulkButton();
        }
    });
</script>
