@model IEnumerable<MedicationAdministrationViewModel>

@if (!Model.Any())
{
    <div class="text-center text-muted py-4">
        <p class="mb-0">No medications found matching your criteria.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 30px;">
                        <ejs-checkbox id="selectAll" cssClass="select-all-checkbox"></ejs-checkbox>
                    </th>
                    <th>Time</th>
                    <th>Resident</th>
                    <th>Medication</th>
                    <th>Dosage</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var med in Model.OrderBy(m => m.ScheduledTime))
                {
                    var isPastDue = med.ScheduledTime < TimeOnly.FromDateTime(DateTime.Now);
                    var checkId = $"listCheck-{med.ScheduleId}";
                    <tr class="medication-item @(isPastDue ? "table-warning" : "")" data-schedule-id="@med.ScheduleId">
                        <td>
                            <ejs-checkbox id="@checkId"
                                          cssClass="med-checkbox"
                                          name="ScheduleIds"
                                          value="@med.ScheduleId.ToString()">
                            </ejs-checkbox>
                        </td>
                        <td>
                            <span class="@(isPastDue ? "text-danger fw-bold" : "")">
                                @med.ScheduledTime.ToString("h:mm tt")
                            </span>
                            @if (isPastDue)
                            {
                                <span class="badge bg-danger ms-1">Past Due</span>
                            }
                        </td>
                        <td>
                            <ejs-button id="residentLink-@med.ScheduleId"
                                        cssClass="e-link e-flat med-resident"
                                        content="@med.ResidentName"
                                        data-alis-get="/Medications/ByResident?residentId=@med.ResidentId"
                                        data-alis-target="#resident-details"
                                        data-alis-trigger="click"
                                        data-alis-indicator="is-loading">
                            </ejs-button>
                        </td>
                        <td>
                            <span class="med-name fw-semibold">@med.MedicationName</span>
                        </td>
                        <td>@med.Dosage</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                @* ALIS: Quick action with POST and confirm - 100% Syncfusion *@
                                <ejs-button id="listQuickGive-@med.ScheduleId"
                                            cssClass="e-success e-small"
                                            content="Given"
                                            data-alis-post="/Medications/QuickGive"
                                            data-alis-collect="self"
                                            data-alis-target="#medications-list"
                                            data-alis-swap="innerHTML"
                                            data-alis-confirm-message="Mark @med.MedicationName as given?"
                                            data-alis-on-after="initMedicationControls"
                                            data-alis-indicator="is-loading">
                                </ejs-button>
                                <input type="hidden" name="scheduleId" value="@med.ScheduleId" />

                                @* ALIS: Load modal content *@
                                <ejs-button id="listOtherBtn-@med.ScheduleId"
                                            cssClass="e-outline e-small"
                                            content="Other"
                                            data-alis-get="/Medications/Administer?scheduleId=@med.ScheduleId"
                                            data-alis-target="#administerModalBody"
                                            data-alis-on-after="showAdministerModal"
                                            data-alis-indicator="is-loading">
                                </ejs-button>

                                @* ALIS: View history *@
                                <ejs-button id="listHistoryBtn-@med.ScheduleId"
                                            cssClass="e-outline e-info e-small"
                                            content="History"
                                            data-alis-get="/Medications/History?residentId=@med.ResidentId"
                                            data-alis-target="#resident-details"
                                            data-alis-swap="innerHTML"
                                            data-alis-indicator="is-loading">
                                </ejs-button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ejs-scripts></ejs-scripts>

<script>
    // Select all checkbox handling via Syncfusion API
    (function() {
        const selectAll = document.getElementById('selectAll');
        if (selectAll && selectAll.ej2_instances && selectAll.ej2_instances[0]) {
            selectAll.ej2_instances[0].change = function(args) {
                document.querySelectorAll('.med-checkbox').forEach(el => {
                    if (el.ej2_instances && el.ej2_instances[0]) {
                        el.ej2_instances[0].checked = args.checked;
                    }
                });
                if (typeof updateBulkButton === 'function') {
                    updateBulkButton();
                }
            };
        }
    })();
</script>
