@model MedicationAdministrationViewModel

<form id="administerForm"
      data-alis-post="/Medications/Administer"
      data-alis-validate="true"
      data-alis-swap="none"
      data-alis-confirm="administerConfirm"
      data-alis-on-after="handleAdministerResult"
      data-alis-duplicate-request="abort">

    <input type="hidden" name="ScheduleId" value="@Model.ScheduleId" />

    <!-- Medication Info Card -->
    <div class="bg-sky-50 border border-sky-200 rounded-lg p-4 mb-4">
        <div class="flex justify-between items-start">
            <div>
                <div class="font-semibold text-slate-800">@Model.MedicationName</div>
                <div class="text-sm text-slate-600">@Model.Dosage</div>
            </div>
            <div class="text-right">
                <div class="font-medium text-slate-800">@Model.ResidentName</div>
                <div class="text-sm text-slate-500">Scheduled: @Model.ScheduledTime.ToString("h:mm tt")</div>
            </div>
        </div>
    </div>

    <!-- Status Selection -->
    <div class="mb-4">
        <ejs-dropdownlist id="adminStatus"
                          name="Status"
                          floatLabelType="Always"
                          placeholder="Administration Status *"
                          value='"Given"'
                          data-val="true"
                          data-val-required="Status is required">
            <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
            <e-data-manager json="@(new[] {
                new { Text = "Given - Medication administered", Value = "Given" },
                new { Text = "Refused - Resident refused", Value = "Refused" },
                new { Text = "Held - Medication held (clinical reason)", Value = "Held" },
                new { Text = "Not Available - Medication unavailable", Value = "NotAvailable" }
            })"></e-data-manager>
        </ejs-dropdownlist>
        <span data-valmsg-for="Status" class="text-red-500 text-sm"></span>
    </div>

    <!-- Notes -->
    <div class="mb-4">
        <ejs-textbox id="adminNotes"
                     name="Notes"
                     floatLabelType="Always"
                     placeholder="Notes"
                     multiline="true"
                     cssClass="e-outline"
                     data-val="true"
                     data-val-maxlength="Maximum 500 characters"
                     data-val-maxlength-max="500">
        </ejs-textbox>
        <span data-valmsg-for="Notes" class="text-red-500 text-sm"></span>
        <p class="text-xs text-slate-500 mt-1">Required if status is Refused, Held, or Not Available</p>
    </div>

    <!-- Administered By -->
    <div class="mb-4">
        <ejs-textbox id="adminBy"
                     name="AdministeredBy"
                     floatLabelType="Always"
                     placeholder="Administered By"
                     value="Current User"
                     readonly="true"
                     cssClass="e-outline">
        </ejs-textbox>
        <p class="text-xs text-slate-500 mt-1">Auto-populated from logged-in user</p>
    </div>

    <!-- Timestamp -->
    <div class="mb-4">
        <ejs-textbox id="adminTime"
                     floatLabelType="Always"
                     placeholder="Time"
                     value="@DateTime.Now.ToString("g")"
                     readonly="true"
                     cssClass="e-outline">
        </ejs-textbox>
        <p class="text-xs text-slate-500 mt-1">Current time will be recorded</p>
    </div>

    <!-- Actions -->
    <div class="flex justify-end gap-2 pt-4 border-t border-slate-200">
        <ejs-button id="adminCancelBtn" cssClass="e-flat" content="Cancel" type="button" onclick="closeAdministerDialog()"></ejs-button>
        <ejs-button id="adminSubmitBtn" type="submit" cssClass="e-primary" isPrimary="true" content="Record Administration" data-alis-indicator="is-loading"></ejs-button>
    </div>
</form>
<ejs-scripts></ejs-scripts>
