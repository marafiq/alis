@model IEnumerable<MedicationSchedule>
@{
    var resident = ViewBag.Resident as Resident;
    var days = ViewBag.Days as int? ?? 7;
}

<div id="resident-details" class="p-6">
    @if (resident == null)
    {
        <div class="text-center py-4 text-slate-400">
            <span class="e-icons e-warning text-2xl mb-2 block"></span>
            <p>Resident not found</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            <!-- Header with Back Button -->
            <div class="flex justify-between items-start">
                <div>
                    <h3 class="font-semibold text-slate-800">@resident.FullName - History</h3>
                    <p class="text-sm text-slate-500">Last @days days</p>
                </div>
                <ejs-button id="backBtn" cssClass="e-filled e-small" content="Back"
                            data-alis-get="/Medications/ByResident?residentId=@resident.Id" data-alis-target="#resident-details"
                            data-alis-swap="outerHTML" data-alis-indicator="is-loading"></ejs-button>
            </div>

            <!-- Days Filter -->
            <div class="flex gap-1">
                @foreach (var d in new[] { 1, 7, 14, 30 })
                {
                    var btnId = $"daysBtn-{d}";
                    var isActive = d == days;
                    <ejs-button id="@btnId" cssClass="@(isActive ? "e-primary e-small" : "e-filled e-small")" content="@(d == 1 ? "1 Day" : $"{d} Days")"
                                data-alis-get="/Medications/History?residentId=@resident.Id&days=@d" data-alis-target="#resident-details"
                                data-alis-swap="outerHTML" data-alis-indicator="is-loading"></ejs-button>
                }
            </div>

            @if (Model.Any())
            {
                <!-- History List -->
                <div class="max-h-64 overflow-y-auto divide-y divide-slate-100">
                    @foreach (var schedule in Model)
                    {
                        <div class="py-3">
                            <div class="flex justify-between items-start">
                                <div class="font-medium text-slate-800">@schedule.Medication?.Name</div>
                                <div class="text-sm text-slate-500">@schedule.ScheduledTime.ToString("h:mm tt")</div>
                            </div>
                            <div class="text-sm text-slate-500">@schedule.Medication?.Dosage</div>
                            <div class="mt-1">
                                <span class="px-2 py-0.5 bg-slate-100 text-slate-600 rounded text-xs">Scheduled</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-slate-400">
                    <p>No medication records for this period</p>
                </div>
            }
        </div>
    }
</div>
<ejs-scripts></ejs-scripts>
