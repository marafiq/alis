@model IEnumerable<MedicationAdministrationViewModel>
@{
    var grouped = Model.GroupBy(m => m.ResidentId);
}

@if (!Model.Any())
{
    <div class="p-8 text-center">
        <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-4">
            <span class="e-icons e-check text-green-600 text-3xl"></span>
        </div>
        <h3 class="text-lg font-semibold text-slate-800 mb-2">All Caught Up!</h3>
        <p class="text-slate-500">No pending medications at this time.</p>
    </div>
}
else
{
    <div class="p-4">
        <div class="grid grid-cols-2 gap-4">
            @foreach (var group in grouped)
            {
                var resident = group.First();
                <div class="border border-slate-200 rounded-lg overflow-hidden hover:shadow-md transition-shadow">
                    <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex justify-between items-center">
                        <ejs-button id="residentBtn-@group.Key"
                                    cssClass="e-link e-flat p-0"
                                    content="@resident.ResidentName"
                                    data-alis-get="/Medications/ByResident?residentId=@group.Key"
                                    data-alis-target="#resident-details"
                                    data-alis-trigger="click"
                                    data-alis-indicator="is-loading">
                        </ejs-button>
                        <span class="px-2 py-1 bg-sky-100 text-sky-700 rounded text-xs font-medium">@group.Count() meds</span>
                    </div>
                    <div class="divide-y divide-slate-100">
                        @foreach (var med in group.OrderBy(m => m.ScheduledTime))
                        {
                            var isPastDue = med.ScheduledTime < TimeOnly.FromDateTime(DateTime.Now);
                            var checkId = $"medCheck-{med.ScheduleId}";
                            <div class="medication-item p-3 @(isPastDue ? "bg-amber-50" : "")" data-schedule-id="@med.ScheduleId">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex items-start gap-3">
                                        <ejs-checkbox id="@checkId" cssClass="med-checkbox mt-1" name="ScheduleIds" value="@med.ScheduleId.ToString()"></ejs-checkbox>
                                        <div>
                                            <span class="med-name font-semibold text-slate-800">@med.MedicationName</span>
                                            <div class="text-sm text-slate-500 mt-0.5">
                                                @med.Dosage <span class="mx-1">•</span>
                                                <span class="@(isPastDue ? "text-red-600 font-medium" : "")">@med.ScheduledTime.ToString("h:mm tt")</span>
                                                @if (isPastDue) { <span class="ml-1 px-1.5 py-0.5 bg-red-100 text-red-700 rounded text-xs">Past Due</span> }
                                            </div>
                                            <span class="med-resident hidden">@resident.ResidentName</span>
                                        </div>
                                    </div>
                                    <div class="flex gap-1">
                                        <ejs-button id="quickGive-@med.ScheduleId" cssClass="e-success e-small e-round" iconCss="e-icons e-check"
                                                    data-alis-post="/Medications/QuickGive" data-alis-collect="self" data-alis-target="#medications-dashboard"
                                                    data-alis-swap="innerHTML" data-alis-confirm-message="Mark @med.MedicationName as given?"
                                                    data-alis-on-after="handleQuickGiveResult" data-alis-indicator="is-loading" title="Quick Give"></ejs-button>
                                        <input type="hidden" name="scheduleId" value="@med.ScheduleId" />
                                        <ejs-button id="detailBtn-@med.ScheduleId" cssClass="e-outline e-small e-round" iconCss="e-icons e-edit"
                                                    data-alis-get="/Medications/Administer?scheduleId=@med.ScheduleId" data-alis-target="#administerModalBody"
                                                    data-alis-on-after="showAdministerModal" data-alis-indicator="is-loading" title="Details"></ejs-button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
<ejs-scripts></ejs-scripts>
