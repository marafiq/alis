@{
    ViewData["Title"] = "Syncfusion + ALIS Integration Test";
}
<div class="row mb-4">
    <div class="col-12">
        <h2 class="mb-0">Syncfusion + ALIS Comprehensive Integration Test</h2>
        <p class="text-muted">All Syncfusion EJ2 controls tested with ALIS framework features</p>
    </div>
</div>
<!-- Section 1: Text Input Controls -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <strong>Section 1: Text Input Controls</strong>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- TextBox -->
            <div class="col-md-4 mb-3">
                <label class="form-label">TextBox (input trigger)</label>
                <ejs-textbox id="testTextBox"
                             name="textboxValue"
                             placeholder="Type here..."
                             showClearButton="true"
                             data-alis-get="/Home/TestSearch"
                             data-alis-trigger="input delay:300ms"
                             data-alis-target="#textbox-result"
                             data-alis-collect="self">
                </ejs-textbox>
                <div id="textbox-result" class="mt-2 small text-muted"></div>
            </div>
            <!-- NumericTextBox -->
            <div class="col-md-4 mb-3">
                <label class="form-label">NumericTextBox (change trigger)</label>
                <ejs-numerictextbox id="testNumeric"
                                    name="numericValue"
                                    min="0"
                                    max="1000"
                                    step="10"
                                    value="100"
                                    format="c2"
                                    data-alis-get="/Home/TestNumericChange"
                                    data-alis-trigger="alis:trigger"
                                    data-alis-target="#numeric-result"
                                    data-alis-collect="self">
                </ejs-numerictextbox>
                <div id="numeric-result" class="mt-2 small text-muted"></div>
            </div>
            <!-- MaskedTextBox -->
            <div class="col-md-4 mb-3">
                <label class="form-label">MaskedTextBox (phone)</label>
                <ejs-maskedtextbox id="testMasked"
                                   name="maskedValue"
                                   mask="(000) 000-0000"
                                   placeholder="(___) ___-____"
                                   data-alis-get="/Home/TestMaskedChange"
                                   data-alis-trigger="change"
                                   data-alis-target="#masked-result"
                                   data-alis-collect="self">
                </ejs-maskedtextbox>
                <div id="masked-result" class="mt-2 small text-muted"></div>
            </div>
        </div>
    </div>
</div>
<!-- Section 2: Selection Controls -->
<div class="card mb-4">
    <div class="card-header bg-success text-white">
        <strong>Section 2: Selection Controls</strong>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- DropDownList -->
            <div class="col-md-4 mb-3">
                <label class="form-label">DropDownList</label>
                <ejs-dropdownlist id="testDropdown"
                                  name="dropdownValue"
                                  placeholder="Select option"
                                  data-alis-get="/Home/TestDropdownChange"
                                  data-alis-trigger="alis:trigger"
                                  data-alis-target="#dropdown-result"
                                  data-alis-collect="self">
                    <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
                    <e-data-manager json="@(new[] {
                        new { Text = "Option 1", Value = "1" },
                        new { Text = "Option 2", Value = "2" },
                        new { Text = "Option 3", Value = "3" }
                    })"></e-data-manager>
                </ejs-dropdownlist>
                <div id="dropdown-result" class="mt-2 small text-muted"></div>
            </div>
            <!-- ComboBox -->
            <div class="col-md-4 mb-3">
                <label class="form-label">ComboBox (editable)</label>
                <ejs-combobox id="testCombobox"
                              name="comboboxValue"
                              placeholder="Select or type"
                              allowCustom="true"
                              data-alis-get="/Home/TestComboChange"
                              data-alis-trigger="alis:trigger"
                              data-alis-target="#combobox-result"
                              data-alis-collect="self">
                    <e-combobox-fields text="Text" value="Value"></e-combobox-fields>
                    <e-data-manager json="@(new[] {
                        new { Text = "Apple", Value = "apple" },
                        new { Text = "Banana", Value = "banana" },
                        new { Text = "Cherry", Value = "cherry" },
                        new { Text = "Date", Value = "date" }
                    })"></e-data-manager>
                </ejs-combobox>
                <div id="combobox-result" class="mt-2 small text-muted"></div>
            </div>
            <!-- AutoComplete -->
            <div class="col-md-4 mb-3">
                <label class="form-label">AutoComplete</label>
                <ejs-autocomplete id="testAutocomplete"
                                  name="autocompleteValue"
                                  placeholder="Type to search"
                                  minLength="1"
                                  data-alis-get="/Home/TestAutocomplete"
                                  data-alis-trigger="alis:trigger"
                                  data-alis-target="#autocomplete-result"
                                  data-alis-collect="self">
                    <e-autocomplete-fields text="Text" value="Value"></e-autocomplete-fields>
                    <e-data-manager json="@(new[] {
                        new { Text = "JavaScript", Value = "js" },
                        new { Text = "TypeScript", Value = "ts" },
                        new { Text = "Python", Value = "py" },
                        new { Text = "CSharp", Value = "cs" },
                        new { Text = "Java", Value = "java" }
                    })"></e-data-manager>
                </ejs-autocomplete>
                <div id="autocomplete-result" class="mt-2 small text-muted"></div>
            </div>
        </div>
        <div class="row">
            <!-- MultiSelect -->
            <div class="col-md-6 mb-3">
                <label class="form-label">MultiSelect (multiple selection)</label>
                <ejs-multiselect id="testMultiselect"
                                 name="multiselectValue"
                                 placeholder="Select items"
                                 mode="Box"
                                 data-alis-get="/Home/TestMultiselect"
                                 data-alis-trigger="alis:trigger"
                                 data-alis-target="#multiselect-result"
                                 data-alis-collect="self">
                    <e-multiselect-fields text="Text" value="Value"></e-multiselect-fields>
                    <e-data-manager json="@(new[] {
                        new { Text = "Red", Value = "red" },
                        new { Text = "Green", Value = "green" },
                        new { Text = "Blue", Value = "blue" },
                        new { Text = "Yellow", Value = "yellow" },
                        new { Text = "Purple", Value = "purple" }
                    })"></e-data-manager>
                </ejs-multiselect>
                <div id="multiselect-result" class="mt-2 small text-muted"></div>
            </div>
            <!-- ListBox -->
            <div class="col-md-6 mb-3">
                <label class="form-label">ListBox</label>
                <ejs-listbox id="testListbox"
                             name="listboxValue"
                             height="120px"
                             data-alis-get="/Home/TestListbox"
                             data-alis-trigger="alis:trigger"
                             data-alis-target="#listbox-result"
                             data-alis-collect="self">
                    <e-listbox-fields text="Text" value="Value"></e-listbox-fields>
                    <e-data-manager json="@(new[] {
                        new { Text = "Item 1", Value = "item1" },
                        new { Text = "Item 2", Value = "item2" },
                        new { Text = "Item 3", Value = "item3" },
                        new { Text = "Item 4", Value = "item4" }
                    })"></e-data-manager>
                </ejs-listbox>
                <div id="listbox-result" class="mt-2 small text-muted"></div>
            </div>
        </div>
    </div>
</div>
<!-- Section 3: Date/Time Controls -->
<div class="card mb-4">
    <div class="card-header bg-info text-white">
        <strong>Section 3: Date/Time Controls</strong>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- DatePicker -->
            <div class="col-md-3 mb-3">
                <label class="form-label">DatePicker</label>
                <ejs-datepicker id="testDatepicker"
                                name="datepickerValue"
                                placeholder="Select date"
                                format="MM/dd/yyyy"
                                data-alis-get="/Home/TestDateChange"
                                data-alis-trigger="alis:trigger"
                                data-alis-target="#datepicker-result"
                                data-alis-collect="self">
                </ejs-datepicker>
                <div id="datepicker-result" class="mt-2 small text-muted"></div>
            </div>
            <!-- TimePicker -->
            <div class="col-md-3 mb-3">
                <label class="form-label">TimePicker</label>
                <ejs-timepicker id="testTimepicker"
                                name="timepickerValue"
                                placeholder="Select time"
                                format="hh:mm a"
                                step="30"
                                data-alis-get="/Home/TestTimeChange"
                                data-alis-trigger="alis:trigger"
                                data-alis-target="#timepicker-result"
                                data-alis-collect="self">
                </ejs-timepicker>
                <div id="timepicker-result" class="mt-2 small text-muted"></div>
            </div>
            <!-- DateTimePicker -->
            <div class="col-md-3 mb-3">
                <label class="form-label">DateTimePicker</label>
                <ejs-datetimepicker id="testDatetimepicker"
                                    name="datetimepickerValue"
                                    placeholder="Select date & time"
                                    format="MM/dd/yyyy hh:mm a"
                                    data-alis-get="/Home/TestDateTimeChange"
                                    data-alis-trigger="alis:trigger"
                                    data-alis-target="#datetimepicker-result"
                                    data-alis-collect="self">
                </ejs-datetimepicker>
                <div id="datetimepicker-result" class="mt-2 small text-muted"></div>
            </div>
            <!-- DateRangePicker -->
            <div class="col-md-3 mb-3">
                <label class="form-label">DateRangePicker</label>
                <ejs-daterangepicker id="testDaterangepicker"
                                     name="daterangepickerValue"
                                     placeholder="Select range"
                                     format="MM/dd/yyyy"
                                     data-alis-get="/Home/TestDateRangeChange"
                                     data-alis-trigger="alis:trigger"
                                     data-alis-target="#daterangepicker-result"
                                     data-alis-collect="self">
                </ejs-daterangepicker>
                <div id="daterangepicker-result" class="mt-2 small text-muted"></div>
            </div>
        </div>
    </div>
</div>
<!-- Section 4: Toggle/Boolean Controls -->
<div class="card mb-4">
    <div class="card-header bg-warning">
        <strong>Section 4: Toggle/Boolean Controls</strong>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- Checkbox -->
            <div class="col-md-3 mb-3">
                <label class="form-label d-block">Checkbox</label>
                <ejs-checkbox id="testCheckbox"
                              name="checkboxValue"
                              label="Enable feature"
                              data-alis-get="/Home/TestCheckboxChange"
                              data-alis-trigger="alis:trigger"
                              data-alis-target="#checkbox-result"
                              data-alis-collect="self">
                </ejs-checkbox>
                <div id="checkbox-result" class="mt-2 small text-muted"></div>
            </div>
            <!-- Switch -->
            <div class="col-md-3 mb-3">
                <label class="form-label d-block">Switch</label>
                <ejs-switch id="testSwitch"
                            name="switchValue"
                            onLabel="ON"
                            offLabel="OFF"
                            data-alis-get="/Home/TestSwitchChange"
                            data-alis-trigger="alis:trigger"
                            data-alis-target="#switch-result"
                            data-alis-collect="self">
                </ejs-switch>
                <div id="switch-result" class="mt-2 small text-muted"></div>
            </div>
            <!-- RadioButton Group -->
            <div class="col-md-6 mb-3">
                <label class="form-label d-block">RadioButton Group</label>
                <div class="d-flex gap-3" id="radioGroup"
                     data-alis-get="/Home/TestRadioChange"
                     data-alis-trigger="change"
                     data-alis-target="#radio-result"
                     data-alis-collect="#radioGroup">
                    <ejs-radiobutton id="radio1" name="radioValue" value="option1" label="Option 1" checked="true"></ejs-radiobutton>
                    <ejs-radiobutton id="radio2" name="radioValue" value="option2" label="Option 2"></ejs-radiobutton>
                    <ejs-radiobutton id="radio3" name="radioValue" value="option3" label="Option 3"></ejs-radiobutton>
                </div>
                <div id="radio-result" class="mt-2 small text-muted"></div>
            </div>
        </div>
    </div>
</div>
<!-- Section 5: Range/Slider Controls -->
<div class="card mb-4">
    <div class="card-header bg-secondary text-white">
        <strong>Section 5: Range/Slider Controls</strong>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- Slider -->
            <div class="col-md-6 mb-3">
                <label class="form-label">Slider (single value)</label>
                <ejs-slider id="testSlider"
                            name="sliderValue"
                            min="0"
                            max="100"
                            value="50"
                            showButtons="true"
                            data-alis-get="/Home/TestSliderChange"
                            data-alis-trigger="alis:trigger"
                            data-alis-target="#slider-result"
                            data-alis-collect="self">
                </ejs-slider>
                <div id="slider-result" class="mt-2 small text-muted"></div>
            </div>
            <!-- Range Slider -->
            <div class="col-md-6 mb-3">
                <label class="form-label">Slider (range)</label>
                <ejs-slider id="testRangeSlider"
                            name="rangeSliderValue"
                            min="0"
                            max="100"
                            value="new int[] {20, 80}"
                            type="Range"
                            data-alis-get="/Home/TestRangeSliderChange"
                            data-alis-trigger="alis:trigger"
                            data-alis-target="#rangeslider-result"
                            data-alis-collect="self">
                </ejs-slider>
                <div id="rangeslider-result" class="mt-2 small text-muted"></div>
            </div>
        </div>
    </div>
</div>
<!-- Section 6: Color/Special Controls -->
<div class="card mb-4">
    <div class="card-header bg-dark text-white">
        <strong>Section 6: Color/Special Controls</strong>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- ColorPicker -->
            <div class="col-md-4 mb-3">
                <label class="form-label">ColorPicker</label>
                <ejs-colorpicker id="testColorpicker"
                                 name="colorpickerValue"
                                 value="#0078d4"
                                 mode="Palette"
                                 data-alis-get="/Home/TestColorChange"
                                 data-alis-trigger="alis:trigger"
                                 data-alis-target="#colorpicker-result"
                                 data-alis-collect="self">
                </ejs-colorpicker>
                <div id="colorpicker-result" class="mt-2 small text-muted"></div>
            </div>
            <!-- File Upload -->
            <div class="col-md-4 mb-3">
                <label class="form-label">Uploader</label>
                <ejs-uploader id="testUploader"
                              name="uploaderValue"
                              autoUpload="false"
                              multiple="true">
                    <e-uploader-asyncsettings saveUrl="/Home/TestUpload" removeUrl="/Home/TestRemove"></e-uploader-asyncsettings>
                </ejs-uploader>
                <div id="uploader-result" class="mt-2 small text-muted"></div>
            </div>
            <!-- Button variants -->
            <div class="col-md-4 mb-3">
                <label class="form-label">Button</label>
                <div class="d-flex gap-2">
                    <ejs-button id="testButton"
                                cssClass="e-primary"
                                content="Load Data"
                                data-alis-get="/Home/TestButtonClick"
                                data-alis-target="#button-result"
                                data-alis-indicator="is-loading">
                    </ejs-button>
                </div>
                <div id="button-result" class="mt-2 small text-muted"></div>
            </div>
        </div>
    </div>
</div>
<!-- Section 7: Rich Text Editor -->
<div class="card mb-4">
    <div class="card-header bg-danger text-white">
        <strong>Section 7: Rich Text Editor</strong>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-12 mb-3">
                <label class="form-label">RichTextEditor</label>
                <ejs-richtexteditor id="testRichtext"
                                    name="richtextValue"
                                    placeholder="Enter content..."
                                    height="200px">
                    <e-richtexteditor-toolbarsettings items="@(new[] { "Bold", "Italic", "Underline", "|", "Formats", "Alignments", "|", "OrderedList", "UnorderedList", "|", "CreateLink", "Image", "|", "SourceCode", "Undo", "Redo" })">
                    </e-richtexteditor-toolbarsettings>
                </ejs-richtexteditor>
                <div class="mt-2">
                    <ejs-button id="richtextSubmit"
                                cssClass="e-success"
                                content="Submit Content"
                                data-alis-post="/Home/TestRichtextSubmit"
                                data-alis-target="#richtext-result"
                                data-alis-collect="#testRichtext">
                    </ejs-button>
                </div>
                <div id="richtext-result" class="mt-2 small text-muted"></div>
            </div>
        </div>
    </div>
</div>
<!-- Section 8: Cascading Dropdowns -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <strong>Section 8: Cascading Controls (ALIS Feature)</strong>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Country</label>
                <ejs-dropdownlist id="cascadeCountry"
                                  name="country"
                                  placeholder="Select country"
                                  data-alis-get="/Home/GetStates"
                                  data-alis-trigger="alis:trigger"
                                  data-alis-target="#cascadeState"
                                  data-alis-swap="syncfusion-datasource"
                                  data-alis-collect="self">
                    <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
                    <e-data-manager json="@(new[] {
                        new { Text = "USA", Value = "usa" },
                        new { Text = "Canada", Value = "canada" },
                        new { Text = "UK", Value = "uk" }
                    })"></e-data-manager>
                </ejs-dropdownlist>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">State/Province</label>
                <ejs-dropdownlist id="cascadeState"
                                  name="state"
                                  placeholder="Select state"
                                  data-alis-get="/Home/GetCities"
                                  data-alis-trigger="alis:trigger"
                                  data-alis-target="#cascadeCity"
                                  data-alis-swap="syncfusion-datasource"
                                  data-alis-collect="self">
                    <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
                </ejs-dropdownlist>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">City</label>
                <ejs-dropdownlist id="cascadeCity"
                                  name="city"
                                  placeholder="Select city">
                    <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
                </ejs-dropdownlist>
            </div>
        </div>
        <div id="cascade-result" class="mt-2 small text-muted"></div>
    </div>
</div>
<!-- Section 9: Form with Validation -->
<div class="card mb-4">
    <div class="card-header bg-success text-white">
        <strong>Section 9: Form Validation (All Controls)</strong>
    </div>
    <div class="card-body">
        <form id="validationForm"
              data-alis-post="/Home/TestFormSubmit"
              data-alis-validate="true"
              data-alis-target="#validation-result"
              data-alis-swap="innerHTML">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Name <span class="text-danger">*</span></label>
                    <ejs-textbox id="valName"
                                 name="Name"
                                 placeholder="Enter name"
                                 data-val="true"
                                 data-val-required="Name is required">
                    </ejs-textbox>
                    <span data-valmsg-for="Name" class="field-validation-valid text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Category <span class="text-danger">*</span></label>
                    <ejs-dropdownlist id="valCategory"
                                      name="Category"
                                      placeholder="Select category"
                                      data-val="true"
                                      data-val-required="Category is required">
                        <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
                        <e-data-manager json="@(new[] {
                            new { Text = "Category A", Value = "a" },
                            new { Text = "Category B", Value = "b" }
                        })"></e-data-manager>
                    </ejs-dropdownlist>
                    <span data-valmsg-for="Category" class="field-validation-valid text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Date <span class="text-danger">*</span></label>
                    <ejs-datepicker id="valDate"
                                    name="Date"
                                    placeholder="Select date"
                                    data-val="true"
                                    data-val-required="Date is required">
                    </ejs-datepicker>
                    <span data-valmsg-for="Date" class="field-validation-valid text-danger"></span>
                </div>
            </div>
            <ejs-button id="valSubmit" type="submit" cssClass="e-primary" content="Submit"></ejs-button>
        </form>
        <div id="validation-result" class="mt-3 border p-2 bg-light"></div>
    </div>
</div>
<!-- Console Log Panel -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>ALIS Telemetry Log</strong>
        <button class="btn btn-sm btn-outline-secondary" onclick="document.getElementById('logPanel').innerHTML = ''">Clear</button>
    </div>
    <div class="card-body">
        <pre id="logPanel" style="max-height: 200px; overflow-y: auto; font-size: 11px; background: #1e1e1e; color: #d4d4d4; padding: 10px; border-radius: 4px;"></pre>
    </div>
</div>
@section Scripts {
    <script>
        window.ALIS_DEBUG = true;
        document.addEventListener('DOMContentLoaded', function() {
            const logPanel = document.getElementById('logPanel');
            function log(msg) {
                const time = new Date().toLocaleTimeString();
                logPanel.innerHTML += `[${time}] ${msg}\n`;
                logPanel.scrollTop = logPanel.scrollHeight;
            }
            // Monitor ALIS events
            document.addEventListener('alis:trigger', function(e) {
                log(`ALIS trigger: ${e.target.id || e.target.name}`);
            });
            log('Page loaded - ready for testing');
        });
    </script>
}
