@model IEnumerable<Resident>
@{
    ViewData["Title"] = "Residents";
    var buildings = ViewBag.Buildings as IEnumerable<DropdownItem> ?? Enumerable.Empty<DropdownItem>();
    var buildingOptions = new[] { new { Text = "All Buildings", Value = "" } }
        .Concat(buildings.Select(b => new { Text = b.Text, Value = b.Value.ToString() }))
        .ToArray();
}

<!-- Page Header -->
<div class="page-header mb-6">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold">Residents</h1>
            <p class="text-sky-100 mt-1">Manage resident information and care details</p>
        </div>
        <ejs-button id="addResidentBtn" cssClass="e-success" iconCss="e-icons e-plus" content="Add Resident"
                    data-alis-get="/Residents/Create" data-alis-target="#modalBody" data-alis-on-after="showResidentModal"></ejs-button>
    </div>
</div>

<!-- Search and Filters -->
<div class="bg-white rounded-xl shadow-sm p-4 mb-6">
    <div class="grid grid-cols-12 gap-4 items-end">
        <div class="col-span-4">
            <ejs-textbox id="searchTextBox" name="query" placeholder="Search by name or room..." showClearButton="true" floatLabelType="Auto" cssClass="e-filled"
                         data-alis-get="/Residents/Search" data-alis-trigger="input delay:300ms" data-alis-target="#residents-list"
                         data-alis-collect="self" data-alis-indicator="is-loading"></ejs-textbox>
        </div>
        <div class="col-span-3">
            <ejs-dropdownlist id="careLevelFilter" name="careLevel" placeholder="All Care Levels" floatLabelType="Auto" cssClass="e-filled" index="0"
                              data-alis-get="/Residents/Search" data-alis-trigger="change" data-alis-target="#residents-list" data-alis-collect="closest .bg-white">
                <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
                <e-data-manager json="@(new[] {
                    new { Text = "All Care Levels", Value = "" },
                    new { Text = "Independent Living", Value = "1" },
                    new { Text = "Assisted Living", Value = "2" },
                    new { Text = "Memory Care", Value = "3" },
                    new { Text = "Skilled Nursing", Value = "4" },
                    new { Text = "Hospice", Value = "5" }
                })"></e-data-manager>
            </ejs-dropdownlist>
        </div>
        <div class="col-span-3">
            <ejs-dropdownlist id="buildingFilter" name="buildingId" placeholder="All Buildings" floatLabelType="Auto" cssClass="e-filled" index="0"
                              data-alis-get="/Residents/Search" data-alis-trigger="change" data-alis-target="#residents-list" data-alis-collect="closest .bg-white">
                <e-dropdownlist-fields text="Text" value="Value"></e-dropdownlist-fields>
                <e-data-manager json="@buildingOptions"></e-data-manager>
            </ejs-dropdownlist>
        </div>
        <div class="col-span-2">
            <ejs-button id="refreshBtn" cssClass="e-filled e-info w-full" iconCss="e-icons e-refresh" content="Refresh"
                        data-alis-get="/Residents/Search" data-alis-target="#residents-list" data-alis-indicator="is-loading"></ejs-button>
        </div>
    </div>
</div>

<!-- Residents List -->
<div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <div id="residents-list">
        @await Html.PartialAsync("_ResidentsList", Model)
    </div>
</div>

<!-- Syncfusion Dialog for Create/Edit -->
<ejs-dialog id="residentDialog" header="Resident" width="700px" isModal="true" visible="false" showCloseIcon="true" closeOnEscape="true"
            animationSettings="@(new Syncfusion.EJ2.Popups.DialogAnimationSettings { Effect = Syncfusion.EJ2.Popups.DialogEffect.Zoom })">
    <e-content-template>
        <div id="modalBody"></div>
    </e-content-template>
</ejs-dialog>

<ejs-scripts></ejs-scripts>

@section Scripts {
<script>
    let residentDialog;
    document.addEventListener('DOMContentLoaded', function() {
        residentDialog = document.getElementById('residentDialog')?.ej2_instances?.[0];
    });

    window.showResidentModal = function(ctx) {
        if (typeof initSyncfusionControls === 'function') {
            initSyncfusionControls({ target: '#modalBody' });
        }
        if (residentDialog) residentDialog.show();
    };

    window.closeResidentModal = function() {
        if (residentDialog) residentDialog.hide();
    };

    window.handleResidentSaved = function(ctx) {
        if (ctx.error) return;
        closeResidentModal();
        // Refresh list
        if (typeof ALIS !== 'undefined') {
            ALIS.request({ url: '/Residents/Search', method: 'GET', target: '#residents-list', swap: 'innerHTML' });
        }
    };
</script>
}
